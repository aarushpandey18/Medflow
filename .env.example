PORT=4000
MONGODB_URI=mongodb+srv://username:password@cluster0.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=medflow
MONGODB_COLLECTION=prescriptions
FIREBASE_PROJECT_ID=your-firebase-project-id
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
# Public HTTPS URL of the Next.js frontend. Required when a QR is generated
# from localhost but must be opened from another device.
NEXT_PUBLIC_APP_BASE_URL=https://your-medflow-frontend.onrender.com
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-5-mini

# Optional alternative to GOOGLE_APPLICATION_CREDENTIALS:
# FIREBASE_SERVICE_ACCOUNT_BASE64=base64-encoded-service-account-json
